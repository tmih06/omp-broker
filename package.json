{
  "name": "omp-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenAI- and Anthropic-compatible API gateway backed by omp subscription logins",
  "bin": {
    "omp-gateway": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts serve",
    "serve": "bun run src/cli.ts serve",
    "login": "bun run src/cli.ts login",
    "status": "bun run src/cli.ts status",
    "models": "bun run src/cli.ts models",
    "check": "tsc --noEmit",
    "test": "bun test",
    "logout": "bun run src/cli.ts logout",
    "providers": "bun run src/cli.ts providers",
    "token": "bun run src/cli.ts token"
  },
  "dependencies": {
    "@oh-my-pi/pi-ai": "18.13.1",
    "@oh-my-pi/pi-catalog": "18.13.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
