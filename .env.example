# omp-broker configuration. Copy to .env (Bun loads it automatically) or export.

# Listen address (default 127.0.0.1:4000)
# OMP_BROKER_BIND=127.0.0.1:4000

# Bearer token override. When unset, $OMP_BROKER_HOME/broker.token is used.
# OMP_BROKER_TOKEN=

# Directory for the token and the isolated credential database.
# OMP_BROKER_HOME=~/.omp-broker

# Explicit credential store. Implies local SQLite mode.
# OMP_BROKER_DB=

# omp (default, shares ~/.omp/agent/agent.db or auth-broker) or local.
# OMP_BROKER_STORAGE=omp

# omp profile/agent directory.
# OMP_BROKER_AGENT_DIR=

# Bare-model provider preference, highest first.
# OMP_BROKER_PROVIDER_ORDER=anthropic,openai-codex,github-copilot,google-antigravity,google-gemini-cli

# Request history SQLite (defaults to $OMP_BROKER_HOME/requests.db).
# OMP_BROKER_LOG_DB=

# Rows kept before old requests are pruned (default 10000).
# OMP_BROKER_LOG_MAX_ENTRIES=10000

# Extracted pi_natives location (defaults to $OMP_BROKER_HOME/natives).
# PI_NATIVES_DIR=

# The Docker image sets: HOME=/data, OMP_BROKER_HOME=/data,
# OMP_BROKER_STORAGE=local, OMP_BROKER_DB=/data/auth.db,
# OMP_BROKER_BIND=0.0.0.0:4000.
