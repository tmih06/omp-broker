# omp-gateway configuration. Copy to .env (Bun loads it automatically) or export.

# Listen address (default 127.0.0.1:4000)
# OMP_GATEWAY_BIND=127.0.0.1:4000

# Bearer token override. When unset, $OMP_GATEWAY_HOME/gateway.token is used.
# OMP_GATEWAY_TOKEN=

# Directory for the token and the isolated credential database.
# OMP_GATEWAY_HOME=~/.omp-gateway

# Explicit credential store. Implies local SQLite mode.
# OMP_GATEWAY_DB=

# omp (default, shares ~/.omp/agent/agent.db or auth-broker) or local.
# OMP_GATEWAY_STORAGE=omp

# omp profile/agent directory.
# OMP_GATEWAY_AGENT_DIR=

# Bare-model provider preference, highest first.
# OMP_GATEWAY_PROVIDER_ORDER=anthropic,openai-codex,github-copilot,google-antigravity,google-gemini-cli
